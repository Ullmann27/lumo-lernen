  "original_findings_and_final_resolution": [
    {
      "id": "CROSS_ROW_POINTER_OWNERSHIP",
      "v1_finding": "Each unchanged InkSurface owns one local pointer, while the screen held one global active row/stroke. A second down in another row replaced that global stroke before the first pointer ended. This was a source-derived flow, not an executed failure replay.",
      "v2_resolution": "The single early return when _activeRow is non-null retains the first screen contact. Existing row checks reject other-row updates and end/cancel events. An ignored contact cannot become active after owner release because it has no new down; a new down after release can own a row.",
      "regression_review": "Two actual widget gesture sequences cover foreign-up-first and owner-up-first, exact saved/preview offsets, continuation, preservation after foreign motion, later fresh contact and unchanged finish behavior.",
      "ink_surface_changed": false
    },
    {
      "id": "STALE_CAMERA_ERROR_CONTEXT",
      "v1_finding": "Success responses checked the captured LearningProfileLease, but catch checked only mounted/mode revision. A late exception after a profile/lease change could report in the new context. The boolean finally also lacked an explicit operation identity. No image/reward leak was asserted.",
      "v2_resolution": "A unique Object owns the pending capture; serialization remains until it settles. Catch requires that same operation plus the captured current lease and mode revision. Finally may release only the identical operation. Lease invalidation blocks content but intentionally permits its settled operation to release its own busy state.",
      "speech_review": "Only the two camera-response calls pass owner. _speak checks that owner before setting the message and again after settings loading before speech; existing mode revision and voice setting checks remain. Other callers retain owner=null behavior.",
      "regression_review": "Three widget cases make the original picker fail after a real profile change, lease reset or mode round trip. They assert no stale error/photo/reward/microphone effect, preserved busy ownership, release on settlement, and a subsequent fresh failure that must still be shown."
    }
  ],
  "additional_v1_review": [
    "The photo action opens the actual camera through ImagePicker only after the existing parental camera gate and current lease/mode checks. It presents the real returned file; microphone answer entry requires a captured photo. Capture itself adds no reward.",
    "Existing parental permission helper and AppState lease implementation are not modified. The eight-file proposal does not modify the journal, writing trainer, InkSurface or speech/PCM modules.",
    "Profile avatar becomes an actual semantic button that calls the existing settings section. Its new widget assertion retains an actual tap and a minimum 48-unit target.",
    "pubspec.lock changes only image_picker_platform_interface from transitive to direct dev dependency; package version/content hash remain unchanged. No runtime package replacement is proposed."
  ],
  "preserved_regressions": {
    "existing_test_lines_in_two_v2_files": "All retained byte-for-byte; independent line comparison contains only insertions.",
