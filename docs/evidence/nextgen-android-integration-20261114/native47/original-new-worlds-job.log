ot.zip" | sha256sum -c -\n          unzip -q "$RUNNER_TEMP/godot.zip" -d "$RUNNER_TEMP/godot-bin"\n          ln -s "$RUNNER_TEMP/godot-bin/Godot_v4.6.3-stable_linux.x86_64" "$RUNNER_TEMP/godot-bin/godot"\n          echo "$RUNNER_TEMP/godot-bin" >> "$GITHUB_PATH"\n      - name: Import production project and exercise real density-aware input\n        env:\n          TOUCH_SCOPE: ${{ matrix.scope }}\n        run: |\n          set -euo pipefail\n          mkdir -p "$LUMO_TOUCH_LOG_DIR"\n          godot --headless --editor --import --quit 2>&1 | tee "$LUMO_TOUCH_LOG_DIR/import.log"\n          if grep -qE \'SCRIPT ERROR|Parse Error|ERROR:\' "$LUMO_TOUCH_LOG_DIR/import.log"; then exit 1; fi\n          bash tools/validate_studio_touch.sh "$TOUCH_SCOPE"\n      - uses: actions/upload-artifact@v4\n        if: always()\n        with:\n          name: lumo-studio-2020-touch-${{ matrix.scope }}\n          path: touch-evidence/\n          if-no-files-found: error\n          retention-days: 30\n\n  bundle-evidence:\n    needs: [new-worlds, touch-density]\n    runs-on: ubuntu-latest\n    timeout-minutes: 12\n    steps:\n      - uses: actions/download-artifact@v4\n        with:\n          name: lumo-studio-2020-worlds-evidence\n          path: native-evidence/\n      - uses: actions/download-artifact@v4\n        with:\n          pattern: lumo-studio-2020-touch-*\n          path: native-evidence/touch-evidence/\n          merge-multiple: true\n      - uses: actions/upload-artifact@v4\n        with:\n          name: lumo-studio-2020-native-evidence\n          path: native-evidence/\n          if-no-files-found: error\n          retention-days: 30\n\n  archive-evidence:\n    needs: [learning-preview, gameplay, new-worlds, studio, touch-density, bundle-evidence]\n    if: github.repository == \'Ullmann27/lumo-godot\' && (github.ref_name == \'chatgpt/lumo-studio-2020-20261114\' || github.ref_name == \'chatgpt/lumo-nextgen-feature-20261114\')\n    runs-on: ubuntu-latest\n    timeout-minutes: 12\n    permissions:\n      contents: write\n      actions: read\n    env:\n      GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}\n      SOURCE_SHA: ${{ github.sha }}\n      RUN_ID: ${{ github.run_id }}\n    steps:\n      - name: Preserve exact original native ZIP without cross-repository credentials\n        run: |\n          set -euo pipefail\n          gh api "repos/Ullmann27/lumo-godot/actions/runs/$RUN_ID/artifacts?per_page=100" > artifacts.json\n          python3 - <<\'PY\'\n          import json, os, re\n          from pathlib import Path\n          artifacts = json.loads(Path(\'artifacts.json\').read_text())[\'artifacts\']\n          matches = [item for item in artifacts if item[\'name\'] == \'lumo-studio-2020-native-evidence\']\n          assert len(matches) == 1, \'Missing or ambiguous current native artifact\'\n          artifact = matches[0]\n          assert artifact[\'expired\'] is False\n          assert artifact[\'workflow_run\'][\'head_sha\'] == os.environ[\'SOURCE_SHA\']\n          assert artifact[\'workflow_run\'][\'id\'] == int(os.environ[\'RUN_ID\'])\n          assert type(artifact[\'id\']) is int and artifact[\'id\'] > 0\n          assert re.fullmatch(r\'sha256:[a-f0-9]{64}\', artifact[\'digest\'])\n          Path(\'artifact-id.txt\').write_text(str(artifact[\'id\']))\n          Path(\'native-artifact.json\').write_text(json.dumps(artifact, indent=2) + \'\\n\')\n          Path(\'native-evidence.zip.sha256\').write_text(artifact[\'digest\'][7:] + \'  native-evidence.zip\\n\')\n          PY\n          artifact_id="$(cat artifact-id.txt)"\n          gh api "repos/Ullmann27/lumo-godot/actions/artifacts/$artifact_id/zip" > native-evidence.zip\n          sha256sum -c native-evidence.zip.sha256\n          tag="studio-2020-evidence-$SOURCE_SHA-$artifact_id"\n          gh api "repos/Ullmann27/lumo-godot/git/matching-refs/tags/$tag" > refs.json\n          gh api --paginate --slurp \'repos/Ullmann27/lumo-godot/releases?per_page=100\' > releases.json\n          python3 - "$tag" <<\'PY\'\n          import json, os, sys\n          from pathlib import Path\n          tag = sys.argv[1]\n          refs = [item for item in json.loads(Path(\'refs.json\').read_text()) if item[\'ref\'] == \'refs/tags/\' + tag]\n          releases = [item for page in json.loads(Path(\'releases.json\').read_text()) for item in page if item[\'tag_name\'] == tag]\n          if refs or releases:\n              assert len(refs) == len(releases) == 1, \'Incomplete archive identity already exists; preserve it\'\n              assert refs[0][\'object\'][\'type\'] == \'commit\' and refs[0][\'object\'][\'sha\'] == os.environ[\'SOURCE_SHA\']\n              assert releases[0][\'draft\'] is False and releases[0][\'prerelease\'] is True\n              assets = [item for item in releases[0][\'assets\'] if item[\'name\'] == \'native-evidence.zip\']\n              assert len(assets) == 1 and assets[0][\'state\'] == \'uploaded\'\n              Path(\'archive-mode.txt\').write_text(\'verify-existing\')\n          else:\n              Path(\'archive-mode.txt\').write_text(\'create\')\n          PY\n          if [ "$(cat archive-mode.txt)" = create ]; then\n            python3 - <<\'PY\'\n          import os\n          from pathlib import Path\n          Path(\'archive-notes.md\').write_text(\n              \'Original native CI evidence archive. This contains test logs and renderer captures, not an APK.\\n\\n\'\n              \'Source: `\' + os.environ[\'SOURCE_SHA\'] + \'`\\n\\n\'\n              \'Workflow: https://github.com/Ullmann27/lumo-godot/actions/runs/\' + os.environ[\'RUN_ID\'] + \'\\n\\n\'\n              \'The ZIP bytes and SHA-256 are identical to the GitHub Actions artifact. \'\n              \'Preserving them here allows the separate Flutter repository to verify the original evidence \'\n              \'without granting its workflow a cross-repository access token. Visual review and Android acceptance remain separate.\\n\')\n          PY\n            gh release create "$tag" native-evidence.zip native-evidence.zip.sha256 native-artifact.json \\\n              --repo Ullmann27/lumo-godot --target "$SOURCE_SHA" \\\n              --title "Studio native evidence $SOURCE_SHA" --notes-file archive-notes.md \\\n              --prerelease --latest=false\n          fi\n          curl --fail --location --retry 3 \\\n            "https://github.com/Ullmann27/lumo-godot/releases/download/$tag/native-evidence.zip" \\\n            --output public-native-evidence.zip\n          cmp native-evidence.zip public-native-evidence.zip\n'
