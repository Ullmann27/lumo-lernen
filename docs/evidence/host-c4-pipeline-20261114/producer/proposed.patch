+def original_metadata():
+    run = {'id':RUN,'run_attempt':1,'head_sha':HOST,'head_branch':c4.BRANCH,
+           'event':'pull_request','path':c4.WORKFLOW,
+           'repository':{'full_name':'Ullmann27/lumo-lernen'}}
