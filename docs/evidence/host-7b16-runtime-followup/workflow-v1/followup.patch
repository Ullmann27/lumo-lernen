+      github.head_ref == 'qa/lumo-android-runtime-7b16-followup-20261114') ||
+      (github.event_name == 'workflow_dispatch' &&
+      github.ref_name == 'qa/lumo-android-runtime-7b16-followup-20261114'))
+    name: followup-diagnostic-probe-contracts
+    runs-on: ubuntu-latest
+    timeout-minutes: 12
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          persist-credentials: false
+          ref: ${{ env.QA_SOURCE }}
+      - name: Read the exact upstream action for the existing adapter contracts
+        uses: actions/checkout@v4
