  "findings": [
    {
      "id": "minimal_version_and_pin",
      "finding": "pubspec.yaml ändert ausschließlich 0.13.7+2019 auf 0.13.8+2020. config/godot-source.json ändert ausschließlich die Revision 803e7a… auf 785413…; Origin und Godot4.6.3 bleiben gleich."
    },
    {
      "id": "historical_identity_preservation",
      "finding": "Alle 50 APPROVED-Einträge der 86445-Basis sind in Schlüssel und vollständigem SHA identisch erhalten. Die einzige neue Bindung ist 2020→785413d395292a243eaa0a0748671eb15d3f80ff. Die Verifierfunktionen selbst sind AST-identisch zur Basis.",
      "baseline_count": 50,
      "current_count": 51,
      "historical_mapping_sha256": "8e30ba078ed723765449a46f8b6bbd5cb786c2bb641dfa9395e5fb19f309ae00"
    },
    {
      "id": "strict_rejection_preserved",
      "finding": "Unbekannte Buildnummern finden weiterhin keinen APPROVED-Eintrag und werden abgewiesen. Origin, exakte drei Konfigurationsschlüssel, Godot-Version und vollständige SHA-Gleichheit bleiben im unveränderten Verifier zwingend. Die neuen 2020-Fälle prüfen darüber hinaus fremde Origin, andere Engine, Zusatzschlüssel, ältere Pins, leere/verkürzte/erfundene SHA sowie die konkret verworfenen 8be3- und acf51-Stände.",
      "explicit_rejected_2020_revisions": [
        "8be3a95d5d948d457c4c39bc6694138d60b70027",
        "acf51d3bd2997c4b731e9a48e1791e05e756a132"
      ],
      "unknown_build_cases": [
        2006,
        2007,
        2008,
        2009,
        2010,
        2021,
        9999
      ]
    },
    {
      "id": "test_delta",
      "finding": "Keiner der 24 bisherigen Testmethodennamen wurde entfernt; zwei 2020-Verträge kommen hinzu. Änderungen an drei vorhandenen Methoden aktualisieren nur den aktuellen Kandidaten, schließen 2020 aus dem historischen Teilmengenhash aus und ersetzen den jetzt ausdrücklich vergebenen unbekannten Build2020 durch2021. Der eigene 2019-Gegenfall für796b bleibt vorhanden.",
      "before_methods": 24,
      "after_methods": 26,
      "added_methods": [
        "test_2020_accepts_its_exact_source_and_preserves_all_historical_pins",
        "test_2020_update_wrapper_requires_the_current_exact_source"
      ],
      "changed_existing_methods": [
        "test_current_candidate_identity_exceeds_existing_2008_and_reserved_2010",
        "test_all_existing_native_identities_are_unchanged",
        "test_unreserved_and_private_checkpoint_versions_stay_closed"
      ]
    },
    {
      "id": "stage_consistency",
      "finding": "Alle vier Dateien sowie der Receipt sind zwischen root/host, assembled/host und test-host bytegleich. Damit bezieht sich der gelesene Root-Testlauf auf dieselben hier geprüften Bytes."
    },
    {
      "id": "receipt_source_binding",
      "finding": "Alle49 Receiptzeilen haben eindeutige Pfade/Archiveinträge und stimmen in Modul, SHA256 und Abmessungen mit dem aktuellen785413-Originalextraktionsindex überein. Version2020, Quelle, Run43570887024, Artefakt14105224381 und ZIP-SHA31c926ae… sind konsistent. Der Reviewer hat in dieser Aufgabe keine49Bilder neu angesehen; seine separate persönliche12er-Sichtprüfung und die übrigen ownergebundenen Sichtprüfungen bleiben eigenständige Evidenz."
    },
    {
      "id": "identity_is_not_release_approval",
      "finding": "Policykommentar und Testmoduldokumentation begrenzen die Bindung ausdrücklich auf Sourceidentität. Der Receipt bezeichnet nur die Native-Renderersichtung als angenommen und lässt genaueAPK-/Android35/37-/Creative-/C4-/Update- sowie physische Fold7-Abnahmen getrennt offen. Der Verifier bestätigt die Buildnummer/Quelle; die aktuelle Marketingversion0.13.8+2020 wird im realen pubspec-Test zusätzlich exakt geprüft."
    }
  ],
