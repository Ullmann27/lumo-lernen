+	var phase := _clock - _blink_start
+	blink = 0.0
+	if phase >= 0.0 and phase < 0.18:
+		blink = clampf(phase / 0.07, 0.0, 1.0) if phase < 0.07 else clampf((0.18 - phase) / 0.11, 0.0, 1.0)
+	elif phase >= 0.18:
+		_blink_cycle += 1
+		_blink_start = _clock + 3.2 + float(_blink_cycle % 3) * 0.35
