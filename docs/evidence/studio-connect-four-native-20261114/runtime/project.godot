config_version=5
[application]
config/name="C4 exact-source local fixture"
run/main_scene="res://scenes/games/connect_four_table.tscn"
[autoload]
HostBridge="*res://scripts/systems/host_bridge.gd"
MobileRuntime="*res://scripts/app/mobile_runtime.gd"
