  "findings": [
    {
      "topic": "CLI and source separation",
      "locations": [
        "publisher:478-497",
        "publisher:345-372",
        "publisher:812-845"
      ],
      "finding": "Every actual candidate and publisher identity, run/attempt, original bundle ID/digest/size and PR485 are explicit mandatory arguments. The executed file is bound to the committed publisher checkout. Candidate HEAD/tree, clean tracked/untracked status, raw index, stage bytes, committed protected files and fixed verifier hashes are checked before and after verifier calls and before mutations. Output must be new and outside both checkouts."
    },
    {
      "topic": "Exact successful run and current PR",
      "locations": [
        "publisher:547-604",
        "publisher:696-705",
        "delivery:175-232"
      ],
      "finding": "Latest-run and exact-attempt metadata must both be completed/success with the actual Host, exact repository/workflow/branch and pull_request event. Current same-repository PR485 must be open and unmoved. Exactly seven distinct successful jobs of the prescribed names are required; the unchanged verifier checks required step names and refuses skipped mandatory steps. Fresh source/run/PR guards precede every mutation."
    },
    {
      "topic": "Complete authenticated bundle",
      "locations": [
        "publisher:410-458",
        "publisher:730-747",
        "delivery:939-1036"
      ],
      "finding": "One actual artifact identity is required from complete API pages. Complete ZIP size and SHA are checked before use, every file is streamed through ZIP CRC and SHA checking, and canonical paths, duplicate names, symlinks, special/encrypted members and expansion limits are rejected. The unchanged check-current ties every local member back to that whole authenticated archive and freshly read original artifact identities."
    },
    {
      "topic": "Native and immutable delivery facts",
      "locations": [
        "publisher:657-693",
        "publisher:795-808",
        "delivery:1013-1036"
      ],
      "finding": "Prepared Host/tree/run/attempt identities must match the explicit accepted candidate. facts.native_source and binding.native_source must agree with its committed config/godot-source.json revision. Historical delivery facts retain published=false and release_approved=false; publication receipts are written only outside the original delivery. Final bundle/member equality is checked again."
    },
    {
      "topic": "Vacancy and no clobber",
      "locations": [
        "publisher:606-648",
        "publisher:730-778",
        "delivery:382-445"
      ],
      "finding": "Release/tag catalogs are paginated to an empty page, tag names are cross-checked against matching refs, version floor and vacancy are checked, and existing release/tag reuse is rejected. Only POST new tag, POST new empty prerelease draft, eleven POST asset uploads and one PATCH of that just-created release are used. No delete, tag update, overwrite, resume, cleanup or mutation retry exists. Unknown outcomes remain a failure requiring review."
    },
    {
      "topic": "Exactly eleven assets and stable identities",
      "locations": [
        "publisher:37-42",
        "publisher:712-728",
        "publisher:758-789",
        "delivery:407-445"
      ],
      "finding": "The fixed eleven-name roster equals the prepared roster. Every original upload byte record is checked; each positive response must supply exact name/state/size/SHA digest/public URL and a fresh ID. Paginated release-asset records must equal the release embedded records and the actual IDs originally returned by uploads. Additional, replaced or duplicate assets stop publication."
    },
    {
      "topic": "Public HTTPS byte verification",
      "locations": [
        "publisher:155-183",
        "publisher:244-303",
        "publisher:779-808",
        "delivery:1095-1107"
      ],
      "finding": "Automatic redirects are disabled. HTTPS scheme/port/host/userinfo/fragment checks apply on each explicit bounded download hop. Authorization is used only on the initial fixed artifact API request and never on redirects; the canonical public APK download uses no Authorization on any hop and no cookie jar. Full length/SHA and readback are required. A fresh release/source/run recheck follows download, and verify-public creates a separate receipt only for matching APK bytes."
    },
    {
      "topic": "Credential-safe originals and failure evidence",
      "locations": [
        "publisher:119-145",
        "publisher:185-242",
        "publisher:306-313",
        "publisher:379-407",
        "publisher:849-864"
      ],
      "finding": "Exact JSON bodies, request-body hashes, HTTP status and full verifier stdout/stderr are retained outside delivery. Signed redirect locations and authorization are not logged. Token-bearing or recognized signed-query responses are omitted with hash/count and explicit failure. Transport exceptions disclose only a fixed code/class, not exception URLs. The verifier child receives an explicit credential-free environment with fresh bytecode-cache namespace."
    },
    {
      "topic": "All32 tests read",
      "locations": [
        "tests:1-620"
      ],
      "finding": "All 32 written methods and their fixtures/API boundaries were read. The baseline synthetic sequence invokes the actual existing verifier CLI dispatcher/functions through a narrow fake Git boundary; network connection attempts are denied. Negative paths cover run/attempt/required steps, bundle bytes/CRC/path/types, vacancy, source/index, uncertain mutations, changing upload IDs/digests, and unauthenticated public-byte failure. These are written contracts, not executed results."
    }
  ],
  "blockers": [],
  "limits": [
    "This is a static independent review only; the 32 tests had not been run during this review.",
    "No final successful real Host candidate/bundle identity or publication result is inferred from the review.",
    "The publisher authenticates the complete original successful CI bundle and reuses the unchanged read-only publication checks. It does not rerun engine/device tests at publication.",
    "Only the public APK is completely downloaded unauthenticated. The other ten assets are checked through exact upload/API digests and identities; no public byte-download claim is made for them.",
    "The proposed source pack intentionally contains no activation workflow. The later separately reviewed workflow must bind exact committed sources and actual final run/artifact inputs, use read-only default permissions, one publisher, an outer timeout and exact checkout SHAs.",
    "Fresh reads do not create a distributed repository lock. A concurrent remote change after the last read remains an API race; the documented single-writer/held-head operational boundary remains necessary.",
    "Per-operation acceptance budgets are not a hard total wall-clock runtime guarantee. Failure may leave a newly created tag/draft or an already published release; automatic recovery is intentionally absent."
  ],
