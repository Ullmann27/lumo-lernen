  "findings": [
    "Only the exact preexisting missing-visible-card exception invokes the word reader; incomplete surface, missing anchors and orientation failures remain terminal.",
    "Word matching requires the full known caption as adjacent level5 words in the same original TSV line and consecutive word numbers; NFKC/case normalization never introduces substring matching.",
    "Original seven variant scales and confidence floor15 are preserved; observed positive word boxes must overlap vertically and have a bounded horizontal gap.",
    "Nala Comet suppresses its contained Comet match only for the same complete word span. Separate repeated regions and conflicting overlapping names are rejected.",
    "Candidates remain within the unchanged left half and observed Karts/footer anchors. Derived coordinates authorize a scroll only, not a selected vehicle or race success.",
    "The entire stable-frame, maximum5 gestures, current PNG hash and remaining deadline suffix is byte-equal. APK/native/selection/driver/cup/save/race methods remain AST-identical."
  ],
  "new_test_methods_read": [
    "test_original_boru_frame_recovers_only_scroll_after_two_bound_frames",
    "test_all_original_fixture_bytes_and_pixels_are_bound_to_the_failed_job",
    "test_original_line_failure_and_existing_exact_comet_path_are_preserved",
    "test_known_complete_names_keep_case_whitespace_and_longest_caption",
    "test_partial_interrupted_cross_line_and_word_number_gap_are_rejected",
    "test_distant_columns_or_disjoint_word_rows_are_not_joined",
    "test_word_confidence_and_original_tsv_presence_remain_mandatory",
    "test_invalid_or_outside_word_rectangles_are_rejected",
    "test_right_preview_header_and_footer_captions_cannot_be_scroll_cards",
    "test_duplicate_real_regions_and_conflicting_names_are_ambiguous",
    "test_same_card_ocr_variants_remain_one_region_and_top_card_order_is_preserved",
    "test_unstable_words_need_a_new_pair_and_changed_png_or_deadline_never_swipe",
    "test_five_gesture_limit_remains_hard_after_word_recovery",
    "test_missing_anchors_or_incomplete_surface_never_activate_word_recovery"
