+/// Fallendes Konfetti aus dem Konfetti-Set (einmal pro Auslösung).
+class MeisterConfetti extends StatefulWidget {
+  const MeisterConfetti({super.key, required this.play, required this.reduceMotion});
+
+  final bool play;
+  final bool reduceMotion;
+
+  @override
+  State<MeisterConfetti> createState() => _MeisterConfettiState();
+}
+
+class _MeisterConfettiState extends State<MeisterConfetti>
+    with SingleTickerProviderStateMixin {
+  // Sofort anlegen: ein erst in dispose() erzeugter (late) Controller würde
+  // auf ein bereits abgemeldetes Element zugreifen (bei reduzierter Bewegung).
+  late final AnimationController _c;
+
+  @override
+  void initState() {
+    super.initState();
+    _c = AnimationController(
+        vsync: this, duration: const Duration(milliseconds: 1900));
+    if (widget.play && !widget.reduceMotion) _c.forward();
+  }
+
+  @override
+  void didUpdateWidget(MeisterConfetti old) {
+    super.didUpdateWidget(old);
+    if (widget.play && !old.play && !widget.reduceMotion) _c.forward(from: 0);
+  }
+
+  @override
+  void dispose() {
+    _c.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (!widget.play) return const SizedBox.shrink();
+    if (widget.reduceMotion) {
+      return IgnorePointer(
+        child: Opacity(
+          opacity: .6,
+          child: Align(
+            alignment: Alignment.topCenter,
+            child: Image.asset(MeisterAssets.confetti, width: 360),
+          ),
+        ),
+      );
+    }
+    return IgnorePointer(
+      child: AnimatedBuilder(
+        animation: _c,
+        builder: (context, _) {
+          final t = _c.value;
+          if (t >= 1) return const SizedBox.shrink();
+          return LayoutBuilder(builder: (context, c) {
+            final w = c.maxWidth;
+            final h = c.maxHeight;
+            return Stack(children: [
+              for (var i = 0; i < 3; i++)
+                Positioned(
+                  left: w * (i / 3) - w * .05,
+                  top: -h * .25 + (h * 1.1) * Curves.easeIn.transform(t) - i * 30,
+                  width: w * .45,
+                  child: Opacity(
+                    opacity: (1 - t).clamp(0, 1),
+                    child: Transform.rotate(
+                      angle: (i.isEven ? 1 : -1) * t * math.pi * .35,
+                      child: Image.asset(MeisterAssets.confetti),
+                    ),
+                  ),
+                ),
+            ]);
+          });
+        },
+      ),
+    );
+  }
+}
