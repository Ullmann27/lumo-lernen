+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  setUpAll(() async {
+    final loader = FontLoader('Nunito');
+    for (final weight in ['Regular', 'Bold', 'ExtraBold', 'Black']) {
+      loader.addFont(rootBundle.load('assets/fonts/Nunito-$weight.ttf'));
+    }
+    await loader.load();
+  });
+  setUp(() {
+    // Geräusche stumm (wie die übrigen Bildschirmtests): kein Audio-Plugin im Test.
+    SharedPreferences.setMockInitialValues({'lumo_sfx_muted': true});
+    LumoSound.instance.muted = true;
+    LumoVoice.instance.isEnabled = false;
+  });
+  tearDown(() => LumoVoice.instance.isEnabled = true);
+
+  for (final entry in _sizes.entries) {
+    testWidgets('${entry.key}: Start, richtig, falsch, Ergebnis ohne Überlauf',
+        (tester) async {
+      addTearDown(() => tester.binding.setSurfaceSize(null));
+      final app = await _open(tester, entry.value);
+      addTearDown(app.dispose);
+      final questions = _questions(2);
+
+      expect(find.text('Wer wird Lumo-Meister?'), findsWidgets);
+      expect(find.text('Show starten'), findsOneWidget);
+      await _capture(tester, '${entry.key}-01-start');
+
+      await _tap(tester, find.byKey(const ValueKey('meister-start')));
+      expect(find.text('Frage 1 von 20'), findsOneWidget);
+      await _capture(tester, '${entry.key}-02-frage');
+
+      await _tap(tester, find.byKey(const ValueKey('meister-joker-tipp')));
+      await _tap(tester,
+          find.byKey(ValueKey('meister-answer-${questions[0].correctIndex}')));
+      await _capture(tester, '${entry.key}-03-auswahl-mit-tipp');
+
+      await _tap(tester, find.byKey(const ValueKey('meister-check')));
+      expect(find.byKey(const ValueKey('meister-feedback-correct')), findsOneWidget);
+      await _capture(tester, '${entry.key}-04-richtig');
+
+      await _tap(tester, find.byKey(const ValueKey('meister-next')));
+      expect(find.text('Frage 2 von 20'), findsOneWidget);
+      final wrong = (questions[1].correctIndex + 1) % 4;
+      await _answer(tester, wrong);
+      expect(find.byKey(const ValueKey('meister-feedback-wrong')), findsOneWidget);
+      await _capture(tester, '${entry.key}-05-falsch');
+
+      await _tap(tester, find.byKey(const ValueKey('meister-to-result')));
+      expect(find.text('Gut versucht!'), findsOneWidget);
+      expect(find.text('1 / 20'), findsOneWidget);
+      // Vor der ersten Stern-Stufe wird nichts gebucht.
+      expect(app.state.stars, 0);
+      await _capture(tester, '${entry.key}-06-ergebnis');
+    });
+  }
+
+  for (final entry in {'telefon': _sizes['telefon']!, 'fold-innen': _sizes['fold-innen']!}.entries) {
+    testWidgets('${entry.key}: alle 20 richtig – Lumo-Meister, 5.000 Sterne genau einmal',
+        (tester) async {
+      addTearDown(() => tester.binding.setSurfaceSize(null));
+      final app = await _open(tester, entry.value);
+      addTearDown(app.dispose);
+      final questions = _questions(2);
+      await _tap(tester, find.byKey(const ValueKey('meister-start')));
+      for (var i = 0; i < 20; i++) {
