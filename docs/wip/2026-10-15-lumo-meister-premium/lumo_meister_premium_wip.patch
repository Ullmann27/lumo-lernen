+import 'dart:math' as math;
+
+import 'package:flutter/material.dart';
+
+import '../../../domain/quiz/quiz_show.dart';
+import 'meister_assets.dart';
+import 'meister_style.dart';
+
+/// Lumo auf dem leuchtenden Podest; atmet leicht, wechselt die Pose weich.
+class MeisterLumo extends StatefulWidget {
+  const MeisterLumo({
+    super.key,
+    required this.pose,
+    required this.height,
+    required this.reduceMotion,
+    this.glow = MeisterAssets.glowGold,
+  });
+
+  final String pose;
+  final double height;
+  final bool reduceMotion;
+  final String glow;
+
+  @override
+  State<MeisterLumo> createState() => _MeisterLumoState();
+}
+
+class _MeisterLumoState extends State<MeisterLumo>
+    with SingleTickerProviderStateMixin {
+  late final AnimationController _breath;
+
+  @override
+  void initState() {
+    super.initState();
+    _breath = AnimationController(
+        vsync: this, duration: const Duration(milliseconds: 2600));
+    if (!widget.reduceMotion) _breath.repeat(reverse: true);
+  }
+
+  @override
+  void didUpdateWidget(MeisterLumo old) {
+    super.didUpdateWidget(old);
+    if (widget.reduceMotion && _breath.isAnimating) _breath.stop();
+    if (!widget.reduceMotion && !_breath.isAnimating) {
+      _breath.repeat(reverse: true);
+    }
+  }
+
+  @override
+  void dispose() {
+    _breath.dispose();
+    super.dispose();
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final h = widget.height;
+    return SizedBox(
+      height: h,
+      child: Stack(
+        alignment: Alignment.bottomCenter,
+        clipBehavior: Clip.none,
+        children: [
+          Positioned(
+            bottom: h * .02,
+            width: h * 1.05,
+            height: h * .95,
+            child: Opacity(opacity: .8, child: Image.asset(widget.glow)),
+          ),
+          // Podest: goldener Ring unter Lumo.
+          Positioned(
+            bottom: 0,
+            child: Container(
+              width: h * .78,
+              height: h * .13,
+              decoration: BoxDecoration(
+                borderRadius: BorderRadius.all(Radius.elliptical(h * .39, h * .065)),
+                gradient: const LinearGradient(
+                  colors: [Color(0xFF173E9E), Color(0xFF2B66E0), Color(0xFF173E9E)],
+                ),
+                border: Border.all(color: MeisterColors.gold, width: 2.2),
+                boxShadow: [
+                  BoxShadow(color: MeisterColors.gold.withOpacity(.45), blurRadius: 18),
+                ],
+              ),
+            ),
+          ),
+          Positioned(
+            bottom: h * .045,
+            height: h * .93,
+            child: AnimatedBuilder(
+              animation: _breath,
+              builder: (context, child) {
+                final t = Curves.easeInOut.transform(_breath.value);
+                return Transform.translate(
+                  offset: Offset(0, -3 * t),
+                  child: Transform.scale(
+                    scale: 1 + .018 * t,
+                    alignment: Alignment.bottomCenter,
+                    child: child,
+                  ),
+                );
+              },
+              child: AnimatedSwitcher(
+                duration: widget.reduceMotion
+                    ? Duration.zero
+                    : const Duration(milliseconds: 380),
+                transitionBuilder: (child, animation) => ScaleTransition(
+                  scale: Tween<double>(begin: .86, end: 1).animate(
+                      CurvedAnimation(parent: animation, curve: Curves.easeOutBack)),
+                  child: FadeTransition(opacity: animation, child: child),
+                ),
+                child: Image.asset(
+                  widget.pose,
+                  key: ValueKey(widget.pose),
+                  height: h * .93,
+                  fit: BoxFit.contain,
+                  semanticLabel: 'Lumo, der Fuchs',
+                ),
+              ),
+            ),
+          ),
+        ],
+      ),
+    );
+  }
+}
+
+enum MeisterAnswerLook { idle, selected, correct, wrong, hidden, faded }
+
+/// Große Antwortkarte A–D mit Buchstaben-Medaillon.
+class MeisterAnswerTile extends StatelessWidget {
+  const MeisterAnswerTile({
+    super.key,
+    required this.letter,
+    required this.text,
+    required this.look,
+    required this.onTap,
+    this.votePercent,
+    this.height = 72,
+  });
+
+  final String letter;
+  final String text;
+  final MeisterAnswerLook look;
+  final VoidCallback? onTap;
+  final int? votePercent;
+  final double height;
+
+  @override
+  Widget build(BuildContext context) {
+    final (List<Color> colors, Color border, Color glow, Color badge) = switch (look) {
+      MeisterAnswerLook.correct => (
+          const [Color(0xFF39E08A), Color(0xFF128A4E), Color(0xFF0B5E36)],
