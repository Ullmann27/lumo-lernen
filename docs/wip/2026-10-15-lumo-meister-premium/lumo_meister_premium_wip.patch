+import 'package:flutter/material.dart';
+
+import 'meister_assets.dart';
+
+/// Farbwelt der Lumo-Meister-Bühne: tiefes Bühnenblau, Gold für Auszeichnung,
+/// Cyan für Auswahl (wie im Rest der Hologlas-App), Grün für „richtig“ und ein
+/// warmes Korall statt Alarmrot für „noch nicht“.
+abstract final class MeisterColors {
+  static const stageTop = Color(0xFF061036);
+  static const stageMid = Color(0xFF0B2370);
+  static const stageBottom = Color(0xFF071A52);
+  static const panel = Color(0xFF0A1F5C);
+  static const panelDeep = Color(0xFF071547);
+  static const gold = Color(0xFFFFC83D);
+  static const goldLight = Color(0xFFFFE89A);
+  static const goldDeep = Color(0xFFE08A12);
+  static const cyan = Color(0xFF53DDFD);
+  static const green = Color(0xFF2FD47A);
+  static const greenDeep = Color(0xFF0E7A45);
+  static const coral = Color(0xFFFF8A7A);
+  static const coralDeep = Color(0xFF8E2D45);
+  static const text = Color(0xFFF7FBFF);
+  static const muted = Color(0xFFB8C8EF);
+}
+
+const _font = 'Nunito';
+
+TextStyle meisterText(double size,
+        {FontWeight weight = FontWeight.w800,
+        Color color = MeisterColors.text,
+        double height = 1.15}) =>
+    TextStyle(
+      fontFamily: _font,
+      fontSize: size,
+      fontWeight: weight,
+      color: color,
+      height: height,
+    );
+
+/// Bühne: Verlauf, zwei Scheinwerfer, Lichtpunkte und ein leuchtendes Podest.
+class MeisterStage extends StatelessWidget {
+  const MeisterStage({super.key, required this.child});
+
+  final Widget child;
+
+  @override
+  Widget build(BuildContext context) {
+    return DecoratedBox(
+      decoration: const BoxDecoration(
+        gradient: LinearGradient(
+          begin: Alignment.topCenter,
+          end: Alignment.bottomCenter,
+          colors: [
+            MeisterColors.stageTop,
+            MeisterColors.stageMid,
+            MeisterColors.stageBottom,
+          ],
+          stops: [0, .55, 1],
+        ),
+      ),
+      child: Stack(
+        fit: StackFit.expand,
+        children: [
+          const IgnorePointer(child: _StageLights()),
+          child,
+        ],
+      ),
+    );
+  }
+}
+
+class _StageLights extends StatelessWidget {
+  const _StageLights();
+
+  @override
+  Widget build(BuildContext context) {
+    return LayoutBuilder(builder: (context, c) {
+      final w = c.maxWidth;
+      final h = c.maxHeight;
+      Widget spot(double left, double angle) => Positioned(
+            left: left,
+            top: -h * .04,
+            width: w * .42,
+            height: h * .78,
+            child: Transform.rotate(
+              angle: angle,
+              alignment: Alignment.topCenter,
+              child: Opacity(
+                opacity: .55,
+                child: Image.asset(MeisterAssets.spotlight, fit: BoxFit.fill),
+              ),
+            ),
+          );
+      Widget dot(double x, double y, double size, String asset) => Positioned(
+            left: x * w - size / 2,
+            top: y * h - size / 2,
+            width: size,
+            height: size,
+            child: Opacity(opacity: .7, child: Image.asset(asset)),
+          );
+      return Stack(children: [
+        spot(-w * .06, -.28),
+        spot(w * .64, .28),
+        Positioned(
+          left: -w * .2,
+          right: -w * .2,
+          bottom: -h * .12,
+          height: h * .34,
+          child: Opacity(
+            opacity: .35,
+            child: Image.asset(MeisterAssets.glowCyan, fit: BoxFit.fill),
+          ),
+        ),
+        dot(.12, .16, 26, MeisterAssets.sparkleGold),
+        dot(.88, .12, 22, MeisterAssets.sparkleCyan),
+        dot(.06, .52, 18, MeisterAssets.sparkleCyan),
+        dot(.94, .46, 20, MeisterAssets.sparkleGold),
+        dot(.50, .05, 16, MeisterAssets.sparkleGold),
+      ]);
+    });
+  }
+}
+
+/// Goldener Schriftzug mit dunkler Kontur und Glanz – eigener Lumo-Stil.
+class MeisterGoldText extends StatelessWidget {
+  const MeisterGoldText(this.text,
+      {super.key, required this.size, this.textAlign = TextAlign.center});
+
+  final String text;
+  final double size;
+  final TextAlign textAlign;
+
+  @override
+  Widget build(BuildContext context) {
+    final base = meisterText(size, weight: FontWeight.w900, height: 1.02);
+    return Stack(
+      alignment: Alignment.center,
+      children: [
+        Text(
+          text,
+          textAlign: textAlign,
+          style: base.copyWith(
+            foreground: Paint()
+              ..style = PaintingStyle.stroke
+              ..strokeWidth = size * .16
+              ..strokeJoin = StrokeJoin.round
+              ..color = const Color(0xFF3A1B05),
+            shadows: const [
+              Shadow(color: Color(0xCC000000), blurRadius: 14, offset: Offset(0, 5)),
+            ],
+          ),
+        ),
+        ShaderMask(
+          blendMode: BlendMode.srcIn,
+          shaderCallback: (rect) => const LinearGradient(
+            begin: Alignment.topCenter,
+            end: Alignment.bottomCenter,
+            colors: [
+              Color(0xFFFFF6C4),
+              MeisterColors.gold,
+              MeisterColors.goldDeep,
+            ],
+            stops: [0, .48, 1],
+          ).createShader(rect),
+          child: Text(text, textAlign: textAlign, style: base),
+        ),
+      ],
+    );
+  }
+}
+
+/// Glas-Panel der Bühne mit Lichtkante.
+BoxDecoration meisterPanel({
+  Color border = MeisterColors.cyan,
+  double radius = 24,
+  double glow = .25,
+  List<Color>? colors,
+}) =>
+    BoxDecoration(
+      gradient: LinearGradient(
+        begin: Alignment.topCenter,
+        end: Alignment.bottomCenter,
+        colors: colors ??
+            const [Color(0xF0123A8F), Color(0xF00A1F5C), Color(0xF0071547)],
+      ),
+      borderRadius: BorderRadius.circular(radius),
+      border: Border.all(color: border.withOpacity(.85), width: 1.6),
+      boxShadow: [
+        BoxShadow(color: border.withOpacity(glow), blurRadius: 18, spreadRadius: 1),
+        const BoxShadow(
+            color: Color(0x66000000), blurRadius: 16, offset: Offset(0, 8)),
+      ],
+    );
+
+/// Große goldene Hauptschaltfläche (mindestens 64 dp hoch).
+class MeisterGoldButton extends StatefulWidget {
+  const MeisterGoldButton({
+    super.key,
+    required this.label,
+    required this.onPressed,
+    this.icon = Icons.chevron_right_rounded,
+    this.height = 64,
+  });
+
+  final String label;
+  final VoidCallback? onPressed;
+  final IconData icon;
+  final double height;
+
+  @override
+  State<MeisterGoldButton> createState() => _MeisterGoldButtonState();
+}
+
+class _MeisterGoldButtonState extends State<MeisterGoldButton> {
+  bool _down = false;
+
+  @override
+  Widget build(BuildContext context) {
+    final enabled = widget.onPressed != null;
+    return Semantics(
+      button: true,
+      enabled: enabled,
+      label: widget.label,
+      excludeSemantics: true,
+      child: GestureDetector(
+        onTapDown: enabled ? (_) => setState(() => _down = true) : null,
+        onTapCancel: () => setState(() => _down = false),
+        onTapUp: enabled ? (_) => setState(() => _down = false) : null,
+        onTap: widget.onPressed,
+        child: AnimatedScale(
+          scale: _down ? .97 : 1,
+          duration: const Duration(milliseconds: 110),
+          child: AnimatedOpacity(
+            opacity: enabled ? 1 : .45,
+            duration: const Duration(milliseconds: 200),
+            child: Container(
+              height: widget.height,
+              alignment: Alignment.center,
+              padding: const EdgeInsets.symmetric(horizontal: 26),
+              decoration: BoxDecoration(
+                gradient: const LinearGradient(
+                  begin: Alignment.topCenter,
+                  end: Alignment.bottomCenter,
+                  colors: [Color(0xFFFFF0A8), MeisterColors.gold, Color(0xFFF2A51C)],
+                  stops: [0, .45, 1],
+                ),
+                borderRadius: BorderRadius.circular(widget.height / 2),
+                border: Border.all(color: const Color(0xFFFFF7D1), width: 2),
+                boxShadow: [
+                  BoxShadow(
+                      color: MeisterColors.gold.withOpacity(enabled ? .55 : .1),
+                      blurRadius: 24,
+                      spreadRadius: 1),
+                  const BoxShadow(
+                      color: Color(0x88000000), blurRadius: 12, offset: Offset(0, 6)),
+                ],
+              ),
+              child: Row(
+                mainAxisSize: MainAxisSize.min,
+                children: [
+                  Flexible(
+                    child: Text(
+                      widget.label,
+                      maxLines: 1,
+                      overflow: TextOverflow.ellipsis,
+                      style: meisterText(widget.height * .38,
+                          weight: FontWeight.w900, color: const Color(0xFF3A1F02)),
+                    ),
+                  ),
+                  const SizedBox(width: 8),
+                  Icon(widget.icon,
+                      size: widget.height * .5, color: const Color(0xFF3A1F02)),
+                ],
+              ),
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+}
+
+/// Zweitrangige Glas-Schaltfläche.
+class MeisterGlassButton extends StatelessWidget {
+  const MeisterGlassButton({
+    super.key,
+    required this.label,
+    required this.icon,
+    required this.onPressed,
+    this.accent = MeisterColors.cyan,
+  });
+
+  final String label;
+  final IconData icon;
+  final VoidCallback onPressed;
+  final Color accent;
+
+  @override
+  Widget build(BuildContext context) {
+    return Semantics(
+      button: true,
+      label: label,
+      excludeSemantics: true,
+      child: Material(
+        color: Colors.transparent,
+        child: InkWell(
+          borderRadius: BorderRadius.circular(30),
+          onTap: onPressed,
+          child: Container(
+            constraints: const BoxConstraints(minHeight: 56),
+            padding: const EdgeInsets.symmetric(horizontal: 18, vertical: 10),
+            decoration: meisterPanel(border: accent, radius: 30, glow: .18),
+            child: Row(
+              mainAxisSize: MainAxisSize.min,
+              mainAxisAlignment: MainAxisAlignment.center,
+              children: [
+                Icon(icon, color: accent, size: 24),
+                const SizedBox(width: 8),
+                Flexible(
+                  child: Text(label,
+                      maxLines: 1,
+                      overflow: TextOverflow.ellipsis,
+                      style: meisterText(17, weight: FontWeight.w900)),
+                ),
+              ],
+            ),
+          ),
+        ),
+      ),
+    );
+  }
+}
+
+/// Runde Glas-Schaltfläche (z. B. Zurück), 52 dp.
+class MeisterRoundButton extends StatelessWidget {
+  const MeisterRoundButton(
+      {super.key, required this.icon, required this.label, required this.onPressed});
+
+  final IconData icon;
+  final String label;
+  final VoidCallback onPressed;
+
+  @override
+  Widget build(BuildContext context) {
+    return Semantics(
+      button: true,
+      label: label,
+      excludeSemantics: true,
+      child: Material(
+        color: Colors.transparent,
+        shape: const CircleBorder(),
+        child: InkWell(
+          customBorder: const CircleBorder(),
+          onTap: onPressed,
+          child: Container(
+            width: 52,
+            height: 52,
+            decoration: BoxDecoration(
+              shape: BoxShape.circle,
+              gradient: const LinearGradient(
+                begin: Alignment.topCenter,
+                end: Alignment.bottomCenter,
+                colors: [Color(0xFF1D4FB8), Color(0xFF0A1F5C)],
+              ),
+              border: Border.all(color: MeisterColors.cyan, width: 1.6),
+              boxShadow: [
+                BoxShadow(color: MeisterColors.cyan.withOpacity(.3), blurRadius: 12),
+              ],
+            ),
+            child: Icon(icon, color: MeisterColors.text, size: 28),
+          ),
+        ),
+      ),
+    );
+  }
+}
+
+/// Sterne-Anzeige mit dem echten Kontostand.
+class MeisterStarChip extends StatelessWidget {
+  const MeisterStarChip({super.key, required this.stars});
+
+  final int stars;
+
+  @override
+  Widget build(BuildContext context) {
+    return Semantics(
+      label: '$stars Sterne',
+      excludeSemantics: true,
+      child: Container(
+        height: 48,
+        padding: const EdgeInsets.fromLTRB(8, 4, 16, 4),
+        decoration: meisterPanel(border: MeisterColors.gold, radius: 26, glow: .25),
+        child: Row(mainAxisSize: MainAxisSize.min, children: [
+          Image.asset(MeisterAssets.star, width: 34, height: 34),
+          const SizedBox(width: 6),
+          Text(formatStars(stars), style: meisterText(19, weight: FontWeight.w900)),
+        ]),
+      ),
+    );
+  }
+}
+
+/// 5000 → „5.000“ (österreichische/deutsche Tausendertrennung).
+String formatStars(int value) {
+  final digits = value.abs().toString();
+  final buffer = StringBuffer(value < 0 ? '-' : '');
+  for (var i = 0; i < digits.length; i++) {
+    if (i > 0 && (digits.length - i) % 3 == 0) buffer.write('.');
+    buffer.write(digits[i]);
+  }
+  return buffer.toString();
+}
