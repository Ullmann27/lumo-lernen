+#!/usr/bin/env python3
+"""Baut die Einzelbilder für „Wer wird Lumo-Meister?“ nach assets/lumo_meister/.
+
+Alle Dateien sind PNG mit echtem Alphakanal (transparenter Hintergrund).
+
+- Lumo-Posen und Belohnungs-Symbole stammen aus den freigegebenen Originalen in
+  assets/lumo_design/ (gleicher Fuchs wie überall in der App: Brille, dunkle Jacke
+  mit leuchtendem „L“). Sie werden nur auf ihren Inhalt zugeschnitten, verkleinert
+  und verlustfrei komprimiert, nicht übermalt.
+- Konfetti, Funken, Leuchten, Scheinwerfer und das Meister-Emblem werden hier
+  reproduzierbar erzeugt (fester Zufallsstartwert), ohne externen Bilddienst.
+
+Aufruf (aus dem Repository-Wurzelverzeichnis):
+    python3 tools/assets/build_lumo_meister_assets.py
+"""
+from __future__ import annotations
+
+import math
+import random
+from pathlib import Path
+
+from PIL import Image, ImageChops, ImageDraw, ImageFilter
+
+ROOT = Path(__file__).resolve().parents[2]
+SRC = ROOT / 'assets' / 'lumo_design'
+OUT = ROOT / 'assets' / 'lumo_meister'
+
+GOLD = (255, 200, 61)
+GOLD_LIGHT = (255, 236, 150)
+CYAN = (67, 225, 255)
+ORANGE = (255, 138, 51)
+PINK = (255, 96, 170)
+WHITE = (255, 255, 255)
+VIOLET = (150, 110, 255)
+
+
+def trimmed(image: Image.Image, margin: int = 8) -> Image.Image:
+    """Schneidet auf den sichtbaren Inhalt (Alpha > 8) plus Rand zu."""
+    alpha = image.getchannel('A').point(lambda v: 255 if v > 8 else 0)
+    box = alpha.getbbox()
+    if box is None:
+        return image
+    left, top, right, bottom = box
+    return image.crop((max(0, left - margin), max(0, top - margin),
+                       min(image.width, right + margin), min(image.height, bottom + margin)))
+
+
+def fit(image: Image.Image, longest: int) -> Image.Image:
+    scale = longest / max(image.size)
+    if scale >= 1:
+        return image
+    return image.resize((round(image.width * scale), round(image.height * scale)),
+                        Image.Resampling.LANCZOS)
+
+
+def save(image: Image.Image, name: str) -> None:
+    if image.mode != 'RGBA':
+        image = image.convert('RGBA')
+    path = OUT / name
+    image.save(path, optimize=True)
+    alpha = image.getchannel('A')
+    transparent = sum(1 for v in alpha.getdata() if v < 10) / (image.width * image.height)
+    print(f'{name:34s} {image.width}x{image.height}  transparent {transparent:4.0%}  '
+          f'{path.stat().st_size // 1024} KB')
+
+
+def derived(source: str, name: str, longest: int) -> None:
+    image = Image.open(SRC / source).convert('RGBA')
+    save(fit(trimmed(image), longest), name)
+
+
+def supersampled(size: tuple[int, int], draw_fn, factor: int = 4) -> Image.Image:
+    """Zeichnet in vierfacher Größe und verkleinert – glatte Kanten."""
+    big = Image.new('RGBA', (size[0] * factor, size[1] * factor), (0, 0, 0, 0))
+    draw_fn(big, factor)
+    return big.resize(size, Image.Resampling.LANCZOS)
+
+
+def star_points(cx: float, cy: float, outer: float, inner: float, tips: int = 5,
+                rotation: float = -math.pi / 2) -> list[tuple[float, float]]:
+    points = []
+    for i in range(tips * 2):
+        radius = outer if i % 2 == 0 else inner
+        angle = rotation + i * math.pi / tips
+        points.append((cx + radius * math.cos(angle), cy + radius * math.sin(angle)))
+    return points
+
+
+def radial_glow(size: int, color: tuple[int, int, int], strength: float = 1.0,
+                falloff: float = 2.2) -> Image.Image:
+    """Weiches, kreisförmiges Leuchten mit Alpha-Verlauf (Mitte hell, Rand transparent)."""
+    image = Image.new('RGBA', (size, size), (0, 0, 0, 0))
+    pixels = image.load()
+    c = (size - 1) / 2
+    for y in range(size):
+        for x in range(size):
+            d = math.hypot(x - c, y - c) / c
+            if d >= 1:
+                continue
+            a = (1 - d) ** falloff * strength
+            # Kern leicht ins Weiße ziehen: wirkt wie echtes Licht.
+            mix = max(0.0, 1 - d * 2.4)
+            r = round(color[0] + (255 - color[0]) * mix)
+            g = round(color[1] + (255 - color[1]) * mix)
+            b = round(color[2] + (255 - color[2]) * mix)
+            pixels[x, y] = (r, g, b, round(min(1.0, a) * 255))
+    return image
+
+
+def sparkle(size: int, color: tuple[int, int, int]) -> Image.Image:
+    """Vierzackiger Funke mit Lichthof."""
+    def draw(img: Image.Image, f: int) -> None:
+        d = ImageDraw.Draw(img)
+        s = size * f
+        c = s / 2
+        for long, short, alpha in ((0.48, 0.07, 255), (0.30, 0.05, 255)):
+            pts = star_points(c, c, s * long, s * short, tips=4, rotation=0)
+            d.polygon(pts, fill=(*color, alpha))
+        core = s * 0.08
+        d.ellipse((c - core, c - core, c + core, c + core), fill=(*WHITE, 255))
+    shape = supersampled((size, size), draw)
+    halo = radial_glow(size, color, strength=0.55, falloff=2.6)
+    halo.alpha_composite(shape)
+    return halo
+
+
+def confetti_set(size: int = 640, pieces: int = 70, seed: int = 1946) -> Image.Image:
+    rng = random.Random(seed)
+    colors = [GOLD, CYAN, ORANGE, PINK, WHITE, VIOLET, (120, 230, 140)]
+
+    def draw(img: Image.Image, f: int) -> None:
+        s = size * f
+        for _ in range(pieces):
+            color = rng.choice(colors)
+            kind = rng.random()
+            cx, cy = rng.uniform(0.06, 0.94) * s, rng.uniform(0.06, 0.94) * s
+            piece = Image.new('RGBA', (int(0.12 * s), int(0.12 * s)), (0, 0, 0, 0))
+            pd = ImageDraw.Draw(piece)
+            w, h = piece.size
+            if kind < 0.45:      # Streifen
+                pw, ph = rng.uniform(0.018, 0.03) * s, rng.uniform(0.05, 0.08) * s
+                pd.rounded_rectangle((w / 2 - pw / 2, h / 2 - ph / 2, w / 2 + pw / 2, h / 2 + ph / 2),
+                                     radius=pw / 3, fill=(*color, 255))
+            elif kind < 0.75:    # Punkt
+                r = rng.uniform(0.010, 0.018) * s
+                pd.ellipse((w / 2 - r, h / 2 - r, w / 2 + r, h / 2 + r), fill=(*color, 255))
+            else:                # kleiner Stern
+                r = rng.uniform(0.022, 0.035) * s
+                pd.polygon(star_points(w / 2, h / 2, r, r * 0.45), fill=(*color, 255))
+            piece = piece.rotate(rng.uniform(0, 360), resample=Image.Resampling.BICUBIC)
+            img.alpha_composite(piece, (int(cx - w / 2), int(cy - h / 2)))
+    return supersampled((size, size), draw)
+
+
+def spotlight(width: int = 420, height: int = 900, color=(160, 210, 255)) -> Image.Image:
+    """Scheinwerferkegel von oben: oben schmal und hell, unten breit und weich."""
+    image = Image.new('RGBA', (width, height), (0, 0, 0, 0))
+    pixels = image.load()
+    for y in range(height):
+        t = y / (height - 1)
+        half = width * (0.06 + 0.44 * t)
+        vertical = (1 - t) ** 1.3 * 0.75 + 0.05
+        for x in range(width):
+            dx = abs(x - width / 2) / half if half else 1
+            if dx >= 1:
+                continue
+            a = vertical * (1 - dx ** 2)
+            pixels[x, y] = (*color, round(max(0.0, min(1.0, a)) * 150))
+    return image.filter(ImageFilter.GaussianBlur(6))
+
+
+def badge() -> Image.Image:
+    """Meister-Emblem: Lorbeerkranz mit Stern (Original) und Krone darüber."""
+    laurel = Image.open(SRC / 'rewards' / 'laurel_star.webp').convert('RGBA')
+    crown = trimmed(Image.open(SRC / 'icons' / 'crown.png').convert('RGBA'))
+    laurel = trimmed(laurel)
+    size = 640
+    canvas = Image.new('RGBA', (size, size), (0, 0, 0, 0))
+    glow = radial_glow(size, GOLD, strength=0.45, falloff=2.4)
+    canvas.alpha_composite(glow)
+    lw = int(size * 0.80)
+    laurel = laurel.resize((lw, int(laurel.height * lw / laurel.width)), Image.Resampling.LANCZOS)
+    top = size - laurel.height - int(size * 0.04)
+    canvas.alpha_composite(laurel, ((size - lw) // 2, top))
+    cw = int(size * 0.46)
+    crown = crown.resize((cw, int(crown.height * cw / crown.width)), Image.Resampling.LANCZOS)
+    canvas.alpha_composite(crown, ((size - cw) // 2, max(0, top - int(crown.height * 0.62))))
+    return trimmed(canvas, margin=4)
+
+
+def main() -> None:
+    OUT.mkdir(parents=True, exist_ok=True)
+    # Lumo – freigegebene Posen
+    derived('fox/fox_arms_open.png', 'lumo_meister_host.png', 760)
+    derived('fox/fox_point_side.png', 'lumo_meister_host_point.png', 760)
+    derived('fox/fox_avatar.png', 'lumo_meister_bust.png', 420)
+    derived('fox/fox_cheer.png', 'lumo_meister_celebration.png', 760)
+    derived('fox/fox_trophy_wink.png', 'lumo_meister_champion.png', 760)
+    derived('fox/fox_thumb_wink.png', 'lumo_meister_encourage.png', 760)
+    # Auszeichnungen und Belohnungen – freigegebene Symbole
+    derived('icons/trophy_gold.png', 'meister_trophy.png', 384)
+    derived('icons/crown.png', 'meister_crown.png', 320)
+    derived('icons/star_gold.png', 'meister_rewards_star.png', 256)
+    derived('rewards/coin_star.webp', 'meister_rewards_coin.png', 256)
+    derived('icons/lightning.webp', 'meister_rewards_xp.png', 256)
+    derived('icons/gift_box.webp', 'meister_rewards_gift.png', 256)
+    derived('icons/treasure_chest.png', 'meister_rewards_chest.png', 320)
+    save(badge(), 'meister_badge.png')
+    # Effekte – erzeugt
+    save(confetti_set(), 'meister_confetti_set.png')
+    save(sparkle(256, GOLD_LIGHT), 'meister_sparkle_gold.png')
+    save(sparkle(256, CYAN), 'meister_sparkle_cyan.png')
+    save(radial_glow(512, GOLD, strength=0.85), 'meister_glow_gold.png')
+    save(radial_glow(512, CYAN, strength=0.75), 'meister_glow_cyan.png')
+    save(radial_glow(512, (120, 235, 150), strength=0.8), 'meister_glow_green.png')
+    save(spotlight(), 'meister_spotlight.png')
+
+
+if __name__ == '__main__':
+    main()
