+        }
+      }
+      expect(find.text('Du bist Lumo-Meister!'), findsOneWidget);
+      expect(find.text('+5.000'), findsOneWidget);
+      expect(app.state.stars, 5000);
+      await _capture(tester, '${entry.key}-09-meister');
+      // Erneuter Aufbau bucht nicht doppelt.
+      await tester.pump(const Duration(seconds: 1));
+      expect(app.state.stars, 5000);
+    });
+  }
+
+  testWidgets('Antwortkarten und Joker sind beschriftete Schaltflächen',
+      (tester) async {
+    final semantics = tester.ensureSemantics();
+    addTearDown(() => tester.binding.setSurfaceSize(null));
+    final app = await _open(tester, _sizes['telefon']!);
+    addTearDown(app.dispose);
+    await _tap(tester, find.byKey(const ValueKey('meister-start')));
+    final q = _questions(2).first;
+    final data = tester
+        .getSemantics(find.byKey(const ValueKey('meister-answer-0')))
+        .getSemanticsData();
+    expect(data.label, 'Antwort A: ${q.options[0]}');
+    expect(data.flagsCollection.isButton, isTrue);
+    expect(data.hasAction(SemanticsAction.tap), isTrue);
+    expect(find.bySemanticsLabel('Joker 50:50'), findsOneWidget);
+    await _tap(tester, find.byKey(const ValueKey('meister-joker-5050')));
+    expect(find.bySemanticsLabel('50:50, schon benutzt'), findsOneWidget);
+    semantics.dispose();
